{
  "name": "linkedin-scam-detector",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered LinkedIn scam detection: rule-based heuristics + LLM analysis, with scan history.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "dotenv-cli": "^11.0.0",
    "postcss": "8.5.31",
    "prisma": "^7.10.1",
    "tailwindcss": "3.4.19"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true
  }
}
