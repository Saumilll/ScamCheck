# Copy this file to .env.local and fill in what you need.
# Every value is optional: with an empty file the app still runs
# (rules-only analysis + local SQLite history).

# ---------- Database ----------
# Leave EMPTY  -> local SQLite file (zero setup, great for VS Code testing).
# Postgres URL -> Supabase / Neon (required on Vercel, because Vercel's disk is not persistent).
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optional: where the local SQLite file lives (ignored when DATABASE_URL is set)
SQLITE_PATH=./data/scans.db

# ---------- AI layer ----------
# Free keys: Groq (starts with gsk_) or Google Gemini (starts with AQ. or AIza). OpenAI keys start with sk-.
# Leave empty to run the rule-based layer only.
AI_API_KEY=

# Optional. If empty, the provider is detected from the key prefix.
# Allowed values: groq | gemini | openai
AI_PROVIDER=

# Optional. Override the default model for your provider.
# Normally leave EMPTY. Defaults: groq=openai/gpt-oss-120b, gemini=gemini-3-flash-preview, openai=gpt-4o-mini.
# If the default is retired, the app automatically tries the next model in lib/ai.js.
AI_MODEL=

# Optional. Use another OpenAI-compatible endpoint (advanced). Leave empty normally.
AI_BASE_URL=

# ---------- Privacy and limits ----------
# Each visitor only sees their own scans (anonymous cookie). Scans are deleted after 30 days (see lib/privacy.js).
# Set to false to stop saving and showing history entirely.
HISTORY_ENABLED=true

# Max scans per IP address per 10 minutes.
RATE_LIMIT_MAX=15
